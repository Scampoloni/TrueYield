# Copy this file to .env for local tooling, or export the variables in your shell.
# Spring Boot does not load .env files by itself.

# Required
MONGODB_URI=mongodb://localhost:27017/trueyield
AUTH0_DOMAIN=example.eu.auth0.com

# Optional: enables the AI summary and chat features
ANTHROPIC_API_KEY=replace_with_anthropic_api_key

# Optional: enable one or more external news providers
GUARDIAN_API_KEY=replace_with_guardian_api_key
NEWSDATA_API_KEY=replace_with_newsdata_api_key
NEWSAPIORG_API_KEY=replace_with_newsapiorg_api_key
ALPHAVANTAGE_API_KEY=replace_with_alphavantage_api_key
