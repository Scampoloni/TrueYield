# These variables are read server-side by SvelteKit. Do not prefix them with VITE_.
API_BASE_URL=http://localhost:8080
AUTH0_DOMAIN=example.eu.auth0.com
AUTH0_CLIENT_ID=replace_with_auth0_client_id
AUTH0_AUDIENCE=https://trueyield.api
# Keep disabled for controlled demos; enable only when Auth0 role assignment is automated.
ALLOW_SIGNUP=false
